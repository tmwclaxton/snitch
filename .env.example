APP_NAME=Snitch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@snitchsocial.net"
MAIL_FROM_NAME="${APP_NAME}"
POSTAL_API_KEY=
POSTAL_BASE_URL=https://postal.grantgunner.org

WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URL="${APP_URL}/authenticate"

# Passport OAuth (Claude.ai MCP connector). Generate with: php artisan passport:keys
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=

STRIPE_KEY=
STRIPE_SECRET=
# Local: stripe listen --forward-to localhost:8000/stripe/webhook
# Use the whsec_ the CLI prints (not the Dashboard endpoint secret).
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLATFORM=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_50=
STRIPE_PRICE_CREDITS_100=
# Comma-separated emails allowed to open /admin (case-insensitive).
ADMIN_EMAILS=tmwclaxton@gmail.com,tobyclaxton@canvassr.org,dan@olympuslab.uk
SNITCH_PLATFORM_FEE_PENCE=1900
SNITCH_CLAIM_BONUS_PENCE=500
# Billable runs need balance strictly greater than this (pence).
SNITCH_MIN_RUN_BALANCE_PENCE=20
SNITCH_BILLING_PRICE_MULTIPLIER=1.75
SNITCH_USD_TO_GBP=0.79
CASHIER_CURRENCY=gbp
SNITCH_TRIAL_DAYS=7

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GA4 (public measurement id). Production sets GOOGLE_ANALYTICS_ENABLED=true.
GOOGLE_ANALYTICS_ID=G-Y3VFH257B5
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ADS_ID=AW-18219075665
GOOGLE_ADS_SIGNUP_SEND_TO=AW-18219075665/xFpFCIDTldQcENGQxO9D

SNITCH_SUPPORT_EMAIL=hello@snitchsocial.net
SNITCH_CONTACT_TO=tmwclaxton@gmail.com

NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_TIMEOUT=180
NANOGPT_EMBEDDING_MODEL=text-embedding-3-small
# NANOGPT_EMBEDDING_DIMENSIONS=
SNITCH_EMBEDDINGS_ENABLED=true
# SNITCH_EMBEDDING_MIN_SIMILARITY=0.22
# SNITCH_EMBEDDING_MAX_CANDIDATES=500
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
FIRECRAWL_TIMEOUT=60
# Music recognition: platform metadata beats these; provider fallbacks are optional.
ACOUSTID_API_KEY=
AUDD_API_KEY=
# SNITCH_MUSIC_RECOGNITION_ENABLED=true
# SNITCH_MUSIC_RECOGNITION_MIN_CONFIDENCE=0.55
# SNITCH_MUSIC_RECOGNITION_CLIP_SECONDS=12
# SNITCH_FPCALC_BINARY=fpcalc
# Spotify link enrichment: uses AudD's spotify id directly (free); when absent, falls back to Firecrawl web search (cached).
# SNITCH_SPOTIFY_RESOLVER_ENABLED=true
# SNITCH_SPOTIFY_RESOLVER_CACHE_TTL=2592000
# SNITCH_SPOTIFY_RESOLVER_SEARCH_LIMIT=5
SNITCH_VIDEO_ANALYSIS_MODEL=qwen3.7-flash
# Completion budget for craft JSON + full verbatim transcript (default 16384).
# SNITCH_VIDEO_ANALYSIS_MAX_TOKENS=16384
SNITCH_WINNER_COPY_MODEL=deepseek/deepseek-v4-flash
SNITCH_BRAND_AUTOFILL_MODEL=deepseek/deepseek-v4-flash
SNITCH_COMPETITOR_SUGGEST_MODEL=deepseek/deepseek-v4-flash
SNITCH_COMPETITOR_SUGGEST_MAX_CANDIDATES=16
SNITCH_COMPETITOR_SUGGEST_MAX_RESOLVES=32
SNITCH_COMPETITOR_SUGGEST_MAX_SUGGESTIONS=16
SNITCH_COMPETITOR_SUGGEST_MIN_SUGGESTIONS=6
SNITCH_COMPETITOR_SUGGEST_SEARCH_LIMIT=8
SNITCH_COMPETITOR_SUGGEST_RESOLVE_CONCURRENCY=4
SNITCH_COMPETITOR_SUGGEST_MAX_PER_PLATFORM=3
SNITCH_SYNC_RECENCY_DAYS=30
SNITCH_SYNC_POSTS_LIMIT=12
SNITCH_SYNC_MIN_INTERVAL_DAYS=7
APIFY_TOKEN=
# Soft monthly Apify COGS cap (USD). At/over this, TikHub handles IG/TT/YT/LI when TIKHUB_API_KEY is set.
SNITCH_APIFY_MONTHLY_CAP_USD=49
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_TIMEOUT=60
APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper
APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
APIFY_ACTOR_FACEBOOK=apify/facebook-posts-scraper
APIFY_ACTOR_LINKEDIN=apimaestro/linkedin-company-posts
APIFY_ACTOR_LINKEDIN_PROFILE=apimaestro/linkedin-profile-posts
APIFY_ACTOR_YOUTUBE=streamers/youtube-scraper
SNITCH_LIVE_APIFY=0
SNITCH_LIVE_TIKHUB=0
SNITCH_LIVE_VIDEO=0
SNITCH_LIVE_ANALYSIS_MATRIX=0
SNITCH_LIVE_E2E=0

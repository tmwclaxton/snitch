{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "firecrawl": {
            "command": "npx",
            "args": [
                "-y",
                "firecrawl-mcp"
            ],
            "env": {
                "FIRECRAWL_API_KEY": "${env:FIRECRAWL_API_KEY}"
            }
        },
        "n8n": {
            "type": "http",
            "url": "https://tmwclaxton.app.n8n.cloud/mcp-server/http",
            "headers": {
                "Authorization": "Bearer ${env:N8N_MCP_TOKEN}"
            }
        },
        "google-ads": {
            "command": "pipx",
            "args": [
                "run",
                "--spec",
                "git+https://github.com/googleads/google-ads-mcp.git",
                "google-ads-mcp"
            ],
            "env": {
                "GOOGLE_APPLICATION_CREDENTIALS": "${env:GOOGLE_APPLICATION_CREDENTIALS}",
                "GOOGLE_PROJECT_ID": "${env:GOOGLE_PROJECT_ID}",
                "GOOGLE_ADS_DEVELOPER_TOKEN": "${env:GOOGLE_ADS_DEVELOPER_TOKEN}"
            }
        },
        "google-analytics": {
            "command": "pipx",
            "args": [
                "run",
                "analytics-mcp"
            ],
            "env": {
                "GOOGLE_APPLICATION_CREDENTIALS": "${env:GOOGLE_APPLICATION_CREDENTIALS}",
                "GOOGLE_PROJECT_ID": "${env:GOOGLE_PROJECT_ID}",
                "GOOGLE_CLOUD_PROJECT": "${env:GOOGLE_PROJECT_ID}"
            }
        },
        "google-search-console": {
            "command": "npx",
            "args": [
                "-y",
                "gluska-seo-gsc-mcp"
            ],
            "env": {
                "GSC_SERVICE_ACCOUNT_PATH": "${env:GSC_SERVICE_ACCOUNT_PATH}"
            }
        },
        "nanogpt": {
            "command": "npx",
            "args": [
                "-y",
                "@nanogpt/mcp"
            ],
            "env": {
                "NANOGPT_API_KEY": "${env:NANOGPT_API_KEY}"
            }
        },
        "github": {
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer ${env:GITHUB_PAT}"
            }
        },
        "stripe": {
            "url": "https://mcp.stripe.com"
        },
        "slack": {
            "url": "https://mcp.slack.com/mcp",
            "auth": {
                "CLIENT_ID": "3660753192626.8903469228982"
            }
        },
        "cloudflare": {
            "type": "http",
            "url": "https://mcp.cloudflare.com/mcp"
        },
        "canva": {
            "url": "https://mcp.canva.com/mcp"
        },
        "claude": {
            "type": "http",
            "url": "https://code.claude.com/docs/mcp"
        },
        "apify": {
            "url": "https://mcp.apify.com"
        }
    }
}

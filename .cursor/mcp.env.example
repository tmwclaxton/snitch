# Copy to mcp.env (gitignored) or export these in your shell / Cursor environment.
# Cursor resolves ${env:VAR} from the process environment.

# Firecrawl - https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# n8n MCP (HTTP) - bearer token from n8n → Settings → MCP
# URL is already set in .cursor/mcp.json (tmwclaxton.app.n8n.cloud)
N8N_MCP_TOKEN=

# NanoGPT - https://nano-gpt.com/api
NANOGPT_API_KEY=

# GitHub - https://github.com/settings/tokens (classic or fine-grained PAT)
GITHUB_PAT=

# Shared Google Cloud credentials (Ads + Analytics)
# Absolute path to ADC or service-account JSON from:
#   gcloud auth application-default login --scopes ...
# or a downloaded service account key.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PROJECT_ID=

# Google Ads - https://developers.google.com/google-ads/api/docs/get-started/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional (MCC): export GOOGLE_ADS_LOGIN_CUSTOMER_ID=... if you access clients via a manager account

# Google Search Console - absolute path to service account JSON with GSC access
# (can be the same file as GOOGLE_APPLICATION_CREDENTIALS if that SA is added in GSC)
GSC_SERVICE_ACCOUNT_PATH=

# Apify - https://console.apify.com/settings/integrations (bearer instead of OAuth)
APIFY_TOKEN=

# Outline MCP - API token from Outline → Settings → API
# URL is already set in .cursor/mcp.json (cineark.getoutline.com)
OUTLINE_API_TOKEN=

# Meta Ads (Pipeboard) - remote HTTP, no env vars in mcp.json
# (auth is handled by the Pipeboard MCP / account link)

# Stripe / Slack / Cloudflare / Canva use OAuth in Cursor (Settings → Tools & MCP → Connect).
# Claude MCP is remote HTTP (https://code.claude.com/docs/mcp) with no env vars.
# Twilio MCP is remote HTTP (https://mcp.twilio.com/docs) - public docs/API search, no auth.

# Local Snitch MCP (HTTP) - Sanctum bearer from Agents page or create_account
SNITCH_MCP_TOKEN=

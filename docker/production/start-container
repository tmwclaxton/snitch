#!/usr/bin/env bash
set -euo pipefail

# Prefer IPv4 when DNS returns A+AAAA. Docker bridges often have broken IPv6 egress,
# which makes WorkOS JWKS / token refresh hang for ~60s and stalls authenticated pages.
if [ ! -f /etc/gai.conf ] || ! grep -q 'precedence :ffff:0:0/96' /etc/gai.conf 2>/dev/null; then
    printf 'precedence :ffff:0:0/96  100\n' >> /etc/gai.conf
fi

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "${WWWUSER:-}" ]; then
    usermod -u "$WWWUSER" sail
fi

# Bind-mounted storage often has host UID/GID; ensure PHP (sail) can write logs, etc.
if [ -d /var/www/html/storage ]; then
    mkdir -p /var/www/html/bootstrap/cache
    chown -R sail:sail /var/www/html/storage /var/www/html/bootstrap/cache 2>/dev/null || true
    chmod -R ug+rwx /var/www/html/storage /var/www/html/bootstrap/cache 2>/dev/null || true

    # Passport keys must exist and be readable by PHP-FPM (sail). Deploy migrate steps
    # sometimes create them as root via compose exec; normalize ownership on every boot.
    if [ ! -f /var/www/html/storage/oauth-private.key ] || [ ! -f /var/www/html/storage/oauth-public.key ]; then
        gosu sail /usr/local/bin/php /var/www/html/artisan passport:keys --force --no-interaction 2>/dev/null || true
    fi

    if [ -f /var/www/html/storage/oauth-private.key ]; then
        chown sail:sail /var/www/html/storage/oauth-private.key /var/www/html/storage/oauth-public.key 2>/dev/null || true
        chmod 600 /var/www/html/storage/oauth-private.key 2>/dev/null || true
        chmod 640 /var/www/html/storage/oauth-public.key 2>/dev/null || true
    fi
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

# Clear any config/route/event cache baked into the image so that environment
# variables injected by docker-compose at runtime are always read fresh.
/usr/local/bin/php /var/www/html/artisan optimize:clear --quiet 2>/dev/null || true

# Warm WorkOS JWKS so the first authenticated hit does not wait on a cold cache.
gosu sail /usr/local/bin/php /var/www/html/artisan snitch:warm-workos-jwk --quiet 2>/dev/null || true

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu "$WWWUSER" "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/supervisord-workers.conf
fi
